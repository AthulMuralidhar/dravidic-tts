# Port exposed on the host by Docker Compose.
DRAVIDIC_TTS_BIND_PORT=8000

# "espeak" is the real, CPU-only local provider. "tone" is only for UI/API
# development and automated tests.
DRAVIDIC_TTS_PROVIDER=espeak

# Maximum Unicode characters accepted by one request.
DRAVIDIC_TTS_MAX_CHARACTERS=5000
