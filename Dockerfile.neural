# syntax=docker/dockerfile:1

FROM python:3.11-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md LICENSE constraints.txt requirements-neural.txt ./
COPY src ./src
RUN python -m pip install --prefix=/install \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.5.1+cpu" \
    && python -m pip install --prefix=/install -r requirements-neural.txt \
    && python -m pip install --prefix=/install --constraint constraints.txt .

FROM python:3.11-slim AS neural-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BHASHAVOX_HOST=0.0.0.0 \
    BHASHAVOX_PORT=8000 \
    BHASHAVOX_TTS_PROVIDER=indic-parler \
    BHASHAVOX_MAX_CHARACTERS=5000 \
    HF_HOME=/home/app/.cache/huggingface

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app \
    && install --directory --owner=app --group=app /home/app/.cache/huggingface

COPY --from=builder /install /usr/local

USER app
WORKDIR /home/app
EXPOSE 8000

CMD ["uvicorn", "bhashavox.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header"]
