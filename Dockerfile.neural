# syntax=docker/dockerfile:1

FROM python:3.11-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pyproject.toml README.md LICENSE constraints.txt requirements-neural.txt ./
COPY src ./src
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN python -m pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==2.5.1+cpu" "torchaudio==2.5.1+cpu" \
    && python -m pip install -r requirements-neural.txt \
    && python -m pip install --constraint constraints.txt .

FROM python:3.11-slim AS neural-runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DRAVIDIC_TTS_HOST=0.0.0.0 \
    DRAVIDIC_TTS_PORT=8000 \
    DRAVIDIC_TTS_PROVIDER=indic-parler \
    DRAVIDIC_TTS_MAX_CHARACTERS=5000 \
    HF_HOME=/home/app/.cache/huggingface \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libsndfile1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app \
    && install --directory --owner=app --group=app /home/app/.cache/huggingface

COPY --from=builder /opt/venv /opt/venv

USER app
WORKDIR /home/app
EXPOSE 8000

CMD ["uvicorn", "dravidic_tts.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-server-header"]
